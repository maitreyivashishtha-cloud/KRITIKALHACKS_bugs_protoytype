// PricePulse — Live Competitor Intelligence Engine
// Prisma schema (SQLite)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A product tracked by "our store" (the hackathon retailer)
model Product {
  id        String   @id @default(cuid())
  name      String
  sku       String   @unique
  category  String   @default("General")
  myPrice   Float // our current retail price
  cost      Float // our unit cost (margin floor guardrail)
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  competitors     Competitor[]
  pricePoints     PricePoint[]
  recommendations Recommendation[]
  scanLogs        ScanLog[]
}

// A competitor discovered via TinySearch, kept per-product
model Competitor {
  id            String    @id @default(cuid())
  productId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  name          String // store name e.g. "TechMart"
  domain        String // e.g. "techmart.com"
  productUrl    String? // direct product page found via TinySearch
  lastCheckedAt DateTime?
  isActive      Boolean   @default(true)

  pricePoints PricePoint[]

  @@unique([productId, domain])
}

// One observed price of a product on a competitor site (or our own price log)
model PricePoint {
  id           String     @id @default(cuid())
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  competitorId String?
  competitor   Competitor? @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  source       String     @default("tinyfish") // tinyfish | demo | own
  price        Float
  currency     String     @default("INR")
  inStock      Boolean    @default(true)
  capturedAt   DateTime   @default(now())

  @@index([productId, capturedAt])
}

// ML engine output: proposed repricing action for a product
model Recommendation {
  id               String   @id @default(cuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  currentPrice     Float
  recommendedPrice Float
  action           String // UNDERCUT | MATCH | RAISE | HOLD
  confidence       Float // 0..1
  rationale        String // human-readable explanation from the ML engine
  status           String   @default("PENDING") // PENDING | APPLIED | DISMISSED
  createdAt        DateTime @default(now())

  @@index([productId, status])
}

// Audit trail of every intelligence scan (TinySearch/TinyFetch usage)
model ScanLog {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  mode            String // live | demo
  status          String // success | partial | failed
  searchQueries   Int      @default(0)
  pagesFetched    Int      @default(0)
  pricesExtracted Int      @default(0)
  message         String?
  createdAt       DateTime @default(now())
}

// Singleton row of repricing policy settings
model Setting {
  id             String  @id @default("singleton")
  strategy       String  @default("UNDERCUT") // UNDERCUT | MATCH | PREMIUM
  undercutPct    Float   @default(1.5) // undercut lowest competitor by %
  maxDeltaPct    Float   @default(5) // max price change per cycle %
  floorMarginPct Float   @default(10) // min margin over cost %
  autoApply      Boolean @default(false)
  apiKey         String? // TinyFish API key (server-side only, never returned raw by the API)
}
